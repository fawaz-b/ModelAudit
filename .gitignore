@'
# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
wheels/
.pybuild/
.pytype/
.pyre/

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling and tests
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
test-results/

# =========================
# Environment variables
# =========================
.env
.env.*
!.env.example
!.env.*.example

# =========================
# Node.js / React / Vite
# =========================
node_modules/
dist/
build/
.vite/
coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# Local data and generated files
# =========================
uploads/
data/uploads/
storage/
artifacts/
*.sqlite
*.sqlite3
*.db
*.log
*.tmp
*.bak

# Model weights and local caches
.cache/
.cache/huggingface/
models/cache/
*.pt
*.pth
*.safetensors

# =========================
# IDE and editor
# =========================
.idea/
*.code-workspace
.vscode/*.local.json

# =========================
# Operating system
# =========================
.DS_Store
Thumbs.db
Desktop.ini

# =========================
# Deployment / secrets
# =========================
*.pem
*.key
*.p12
*.pfx
secrets/
'@ | Set-Content .gitignore -Encoding utf8
